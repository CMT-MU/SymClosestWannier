restart = cw ! 'cw'/'w90'

outdir = './'

disentangle = false
proj_min    = 0.5
verbose     = true

write_hr       = true
write_info_data = true

# symmetrization
symmetrization = true
mp_outdir      = './ch4/'
mp_seedname    = ch4
ket_amn        = [[C,1,0,(s,u)],[C,1,0,(s,d)],[C,1,1,(pz,u)],[C,1,1,(pz,d)],[C,1,1,(px,u)],[C,1,1,(px,d)],[C,1,1,(py,u)],[C,1,1,(py,d)],[H,1,0,(s,u)],[H,1,0,(s,d)],[H,2,0,(s,u)],[H,2,0,(s,d)],[H,4,0,(s,u)],[H,4,0,(s,d)],[H,3,0,(s,u)],[H,3,0,(s,d)]]
irreps         = full
