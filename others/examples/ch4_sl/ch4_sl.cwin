restart = cw ! 'cw'/'w90'

outdir = './'

disentangle = false
proj_min    = 0.5
verbose     = true

write_hr = .true.
write_sr = .true.

# symmetrization
symmetrization = true
mp_outdir      = './ch4_sl'
mp_seedname    = ch4_sl
ket_amn        = [[C,1,0,s],[C,1,1,pz],[C,1,1,px],[C,1,1,py],[H,1,0,s],[H,2,0,s],[H,4,0,s],[H,3,0,s]]
irreps         = full
