restart = cw ! 'cw'/'w90'
outdir = './'

disentangle       = true
proj_min          = 0.0
cwf_mu_max      = 2.3
cwf_mu_min      = -7.5
cwf_sigma_max = 2.0
cwf_sigma_min = 1.0
cwf_delta             = 0.0
svd               = true
verbose           = true

write_hr = .true.
write_sr = .true.

N1 = 50

# symmetrization
symmetrization = true
mp_outdir      = './graphene_pz'
mp_seedname    = graphene_pz
ket_amn        = auto
irreps         = full ! full/all/list
