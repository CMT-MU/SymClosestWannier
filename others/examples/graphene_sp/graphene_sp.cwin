restart = cw ! 'cw'/'w90'

outdir = '.'

disentangle       = true
proj_min          = 0.0
cwf_mu_max      = 0
cwf_mu_min      = -30
cwf_sigma_max = 6
cwf_sigma_min = 1e-6
cwf_delta             = 0.0
svd               = true
verbose           = true

write_hr = .true.
write_sr = .true.

N1 = 50

# symmetrization
symmetrization = true
mp_outdir      = './graphene_sp'
mp_seedname    = graphene_sp
ket_amn        = auto
irreps         = full ! full/all/list

