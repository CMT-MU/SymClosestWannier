restart = cw ! 'cw'/'w90'

outdir = './'

disentangle = false
proj_min    = 0.7
verbose     = true

write_hr = .true.
write_sr = .true.

N1 = 50

# symmetrization
symmetrization = true
mp_outdir      = './srvo3_d'
mp_seedname    = srvo3_d
ket_amn        = [[V,1,2,dxz],[V,1,2,dyz],[V,1,2,dxy]]
irreps         = full ! full/all/list
