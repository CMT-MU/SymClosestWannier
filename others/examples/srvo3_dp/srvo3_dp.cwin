restart = cw ! 'cw'/'w90'

outdir = './'

disentangle = false
proj_min    = 0.7
verbose     = true

write_hr = .true.
write_sr = .true.

N1 = 50

# symmetrization
symmetrization = true
mp_outdir      = './srvo3_dp'
mp_seedname    = srvo3_dp
ket_amn        = auto
irreps         = full ! full/all/list
