restart = cw ! 'cw'/'w90'

outdir = './'

disentangle = false
proj_min    = 0.5
verbose     = true

write_hr = .true.
write_sr = .true.

N1 = 50

# symmetrization
symmetrization = true
mp_outdir      = './mos2_11orbs'
mp_seedname    = mos2_11orbs
ket_amn        = [[Mo,1,2,du],[Mo,1,2,dxz],[Mo,1,2,dyz],[Mo,1,2,dv],[Mo,1,2,dxy],[S,1,1,pz],[S,1,1,px],[S,1,1,py],[S,2,1,pz],[S,2,1,px],[S,2,1,py]]
irreps         = full ! full/all/list
